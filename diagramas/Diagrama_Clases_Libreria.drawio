        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Diagrama_Clases_Libreria\ntitle Diagrama de Clases - API Librería (Fredy Linares)\n\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam packageStyle rectangle\nleft to right direction\n\npackage \&quot;persistence.entity\&quot; {\n  class AutorEntity &lt;&lt;Entity&gt;&gt; {\n    - idAutor : Integer\n    - nombre : String\n    - pais : String\n    - libros : List&lt;LibroEntity&gt;\n    + getIdAutor() : Integer\n    + getNombre() : String\n    + setNombre(nombre : String) : void\n    + getPais() : String\n    + setPais(pais : String) : void\n    + getLibros() : List&lt;LibroEntity&gt;\n  }\n\n  class EditorialEntity &lt;&lt;Entity&gt;&gt; {\n    - idEditorial : Integer\n    - nombre : String\n    - pais : String\n    - libros : List&lt;LibroEntity&gt;\n    + getIdEditorial() : Integer\n    + getNombre() : String\n    + setNombre(nombre : String) : void\n    + getPais() : String\n    + setPais(pais : String) : void\n    + getLibros() : List&lt;LibroEntity&gt;\n  }\n\n  class LibroEntity &lt;&lt;Entity&gt;&gt; {\n    - idLibro : Integer\n    - titulo : String\n    - fechaPublicacion : LocalDate\n    - autor : AutorEntity\n    - editorial : EditorialEntity\n    + getIdLibro() : Integer\n    + getTitulo() : String\n    + setTitulo(titulo : String) : void\n    + getFechaPublicacion() : LocalDate\n    + setFechaPublicacion(f : LocalDate) : void\n    + getAutor() : AutorEntity\n    + setAutor(a : AutorEntity) : void\n    + getEditorial() : EditorialEntity\n    + setEditorial(e : EditorialEntity) : void\n  }\n}\n\npackage \&quot;persistence.repository\&quot; {\n  interface \&quot;JpaRepository&lt;T, ID&gt;\&quot; as JpaRepository &lt;&lt;Spring Data&gt;&gt;\n  interface AutorRepository &lt;&lt;Repository&gt;&gt;\n  interface EditorialRepository &lt;&lt;Repository&gt;&gt;\n  interface LibroRepository &lt;&lt;Repository&gt;&gt; {\n    + findByAutorIdAutor(idAutor : Integer) : List&lt;LibroEntity&gt;\n    + findByEditorialIdEditorial(idEditorial : Integer) : List&lt;LibroEntity&gt;\n    + findByTituloContainingIgnoreCase(texto : String) : List&lt;LibroEntity&gt;\n    + existsByAutorIdAutor(idAutor : Integer) : boolean\n    + existsByEditorialIdEditorial(idEditorial : Integer) : boolean\n  }\n}\n\npackage \&quot;dto\&quot; {\n  class AutorRequestDTO &lt;&lt;record&gt;&gt; {\n    + nombre : String\n    + pais : String\n  }\n  class AutorResponseDTO &lt;&lt;record&gt;&gt; {\n    + idAutor : Integer\n    + nombre : String\n    + pais : String\n    + totalLibros : Integer\n  }\n  class EditorialRequestDTO &lt;&lt;record&gt;&gt; {\n    + nombre : String\n    + pais : String\n  }\n  class EditorialResponseDTO &lt;&lt;record&gt;&gt; {\n    + idEditorial : Integer\n    + nombre : String\n    + pais : String\n    + totalLibros : Integer\n  }\n  class LibroRequestDTO &lt;&lt;record&gt;&gt; {\n    + titulo : String\n    + fechaPublicacion : LocalDate\n    + idAutor : Integer\n    + idEditorial : Integer\n  }\n  class LibroResponseDTO &lt;&lt;record&gt;&gt; {\n    + idLibro : Integer\n    + titulo : String\n    + fechaPublicacion : LocalDate\n    + idAutor : Integer\n    + nombreAutor : String\n    + idEditorial : Integer\n    + nombreEditorial : String\n  }\n  class ErrorResponseDTO &lt;&lt;record&gt;&gt; {\n    + timestamp : LocalDateTime\n    + status : int\n    + error : String\n    + mensaje : String\n    + ruta : String\n    + detalles : List&lt;String&gt;\n  }\n}\n\npackage \&quot;mapper\&quot; {\n  class AutorMapper &lt;&lt;Component&gt;&gt; {\n    + toResponse(e : AutorEntity) : AutorResponseDTO\n    + toEntity(dto : AutorRequestDTO) : AutorEntity\n    + updateEntity(dto : AutorRequestDTO, e : AutorEntity) : void\n  }\n  class EditorialMapper &lt;&lt;Component&gt;&gt; {\n    + toResponse(e : EditorialEntity) : EditorialResponseDTO\n    + toEntity(dto : EditorialRequestDTO) : EditorialEntity\n    + updateEntity(dto : EditorialRequestDTO, e : EditorialEntity) : void\n  }\n  class LibroMapper &lt;&lt;Component&gt;&gt; {\n    + toResponse(e : LibroEntity) : LibroResponseDTO\n    + toEntity(dto : LibroRequestDTO, a : AutorEntity, ed : EditorialEntity) : LibroEntity\n    + updateEntity(dto : LibroRequestDTO, a : AutorEntity, ed : EditorialEntity, e : LibroEntity) : void\n  }\n}\n\npackage \&quot;service\&quot; {\n  interface \&quot;ICrudService&lt;REQ, RES, ID&gt;\&quot; as ICrudService {\n    + listar() : List&lt;RES&gt;\n    + buscarPorId(id : ID) : RES\n    + crear(dto : REQ) : RES\n    + actualizar(id : ID, dto : REQ) : RES\n    + eliminar(id : ID) : void\n  }\n  interface AutorService\n  interface EditorialService\n  interface LibroService {\n    + listarPorAutor(idAutor : Integer) : List&lt;LibroResponseDTO&gt;\n    + listarPorEditorial(idEditorial : Integer) : List&lt;LibroResponseDTO&gt;\n    + buscarPorTitulo(texto : String) : List&lt;LibroResponseDTO&gt;\n  }\n\n  package \&quot;impl\&quot; {\n    class AutorServiceImpl &lt;&lt;Service&gt;&gt; {\n      - autorRepository : AutorRepository\n      - libroRepository : LibroRepository\n      - mapper : AutorMapper\n      - obtenerEntidad(id : Integer) : AutorEntity\n    }\n    class EditorialServiceImpl &lt;&lt;Service&gt;&gt; {\n      - editorialRepository : EditorialRepository\n      - libroRepository : LibroRepository\n      - mapper : EditorialMapper\n      - obtenerEntidad(id : Integer) : EditorialEntity\n    }\n    class LibroServiceImpl &lt;&lt;Service&gt;&gt; {\n      - libroRepository : LibroRepository\n      - autorRepository : AutorRepository\n      - editorialRepository : EditorialRepository\n      - mapper : LibroMapper\n      - obtenerEntidad(id : Integer) : LibroEntity\n      - obtenerAutor(idAutor : Integer) : AutorEntity\n      - obtenerEditorial(idEditorial : Integer) : EditorialEntity\n    }\n  }\n}\n\npackage \&quot;controller\&quot; {\n  class AutorController &lt;&lt;RestController&gt;&gt; {\n    - autorService : AutorService\n    - libroService : LibroService\n    + listar() : ResponseEntity&lt;List&lt;AutorResponseDTO&gt;&gt;\n    + buscarPorId(id : Integer) : ResponseEntity&lt;AutorResponseDTO&gt;\n    + librosDelAutor(id : Integer) : ResponseEntity&lt;List&lt;LibroResponseDTO&gt;&gt;\n    + crear(dto : AutorRequestDTO) : ResponseEntity&lt;AutorResponseDTO&gt;\n    + actualizar(id : Integer, dto : AutorRequestDTO) : ResponseEntity&lt;AutorResponseDTO&gt;\n    + eliminar(id : Integer) : ResponseEntity&lt;Void&gt;\n  }\n  class EditorialController &lt;&lt;RestController&gt;&gt; {\n    - editorialService : EditorialService\n    - libroService : LibroService\n    + listar() : ResponseEntity&lt;List&lt;EditorialResponseDTO&gt;&gt;\n    + buscarPorId(id : Integer) : ResponseEntity&lt;EditorialResponseDTO&gt;\n    + librosDeLaEditorial(id : Integer) : ResponseEntity&lt;List&lt;LibroResponseDTO&gt;&gt;\n    + crear(dto : EditorialRequestDTO) : ResponseEntity&lt;EditorialResponseDTO&gt;\n    + actualizar(id : Integer, dto : EditorialRequestDTO) : ResponseEntity&lt;EditorialResponseDTO&gt;\n    + eliminar(id : Integer) : ResponseEntity&lt;Void&gt;\n  }\n  class LibroController &lt;&lt;RestController&gt;&gt; {\n    - libroService : LibroService\n    + listar() : ResponseEntity&lt;List&lt;LibroResponseDTO&gt;&gt;\n    + buscarPorTitulo(titulo : String) : ResponseEntity&lt;List&lt;LibroResponseDTO&gt;&gt;\n    + buscarPorId(id : Integer) : ResponseEntity&lt;LibroResponseDTO&gt;\n    + crear(dto : LibroRequestDTO) : ResponseEntity&lt;LibroResponseDTO&gt;\n    + actualizar(id : Integer, dto : LibroRequestDTO) : ResponseEntity&lt;LibroResponseDTO&gt;\n    + eliminar(id : Integer) : ResponseEntity&lt;Void&gt;\n  }\n}\n\npackage \&quot;exception\&quot; {\n  class GlobalExceptionHandler &lt;&lt;RestControllerAdvice&gt;&gt; {\n    + handleNotFound(...) : ResponseEntity&lt;ErrorResponseDTO&gt;\n    + handleConflict(...) : ResponseEntity&lt;ErrorResponseDTO&gt;\n    + handleBadRequest(...) : ResponseEntity&lt;ErrorResponseDTO&gt;\n    + handleValidation(...) : ResponseEntity&lt;ErrorResponseDTO&gt;\n    + handleIntegrity(...) : ResponseEntity&lt;ErrorResponseDTO&gt;\n    + handleGeneric(...) : ResponseEntity&lt;ErrorResponseDTO&gt;\n  }\n  class ResourceNotFoundException\n  class ConflictException\n  class BadRequestException\n  class RuntimeException\n}\n\npackage \&quot;config\&quot; {\n  class OpenApiConfig &lt;&lt;Configuration&gt;&gt; {\n    + libreriaOpenAPI() : OpenAPI\n  }\n}\n\n&#39; ---------- Relaciones ----------\nAutorEntity \&quot;0..1\&quot; -- \&quot;0..*\&quot; LibroEntity : autor &lt;\nEditorialEntity \&quot;0..1\&quot; -- \&quot;0..*\&quot; LibroEntity : editorial &lt;\n\nAutorRepository --|&gt; JpaRepository\nEditorialRepository --|&gt; JpaRepository\nLibroRepository --|&gt; JpaRepository\nAutorRepository ..&gt; AutorEntity\nEditorialRepository ..&gt; EditorialEntity\nLibroRepository ..&gt; LibroEntity\n\nAutorService --|&gt; ICrudService\nEditorialService --|&gt; ICrudService\nLibroService --|&gt; ICrudService\nAutorServiceImpl ..|&gt; AutorService\nEditorialServiceImpl ..|&gt; EditorialService\nLibroServiceImpl ..|&gt; LibroService\n\nAutorServiceImpl --&gt; AutorRepository\nAutorServiceImpl --&gt; LibroRepository\nAutorServiceImpl --&gt; AutorMapper\nEditorialServiceImpl --&gt; EditorialRepository\nEditorialServiceImpl --&gt; LibroRepository\nEditorialServiceImpl --&gt; EditorialMapper\nLibroServiceImpl --&gt; LibroRepository\nLibroServiceImpl --&gt; AutorRepository\nLibroServiceImpl --&gt; EditorialRepository\nLibroServiceImpl --&gt; LibroMapper\n\nAutorMapper ..&gt; AutorEntity\nAutorMapper ..&gt; AutorRequestDTO\nAutorMapper ..&gt; AutorResponseDTO\nEditorialMapper ..&gt; EditorialEntity\nEditorialMapper ..&gt; EditorialRequestDTO\nEditorialMapper ..&gt; EditorialResponseDTO\nLibroMapper ..&gt; LibroEntity\nLibroMapper ..&gt; LibroRequestDTO\nLibroMapper ..&gt; LibroResponseDTO\n\nAutorController --&gt; AutorService\nAutorController --&gt; LibroService\nEditorialController --&gt; EditorialService\nEditorialController --&gt; LibroService\nLibroController --&gt; LibroService\n\nResourceNotFoundException --|&gt; RuntimeException\nConflictException --|&gt; RuntimeException\nBadRequestException --|&gt; RuntimeException\nGlobalExceptionHandler ..&gt; ErrorResponseDTO\nGlobalExceptionHandler ..&gt; ResourceNotFoundException\nGlobalExceptionHandler ..&gt; ConflictException\nGlobalExceptionHandler ..&gt; BadRequestException\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1-kEXukRVk_CmwjZzJZD-1">
