@startuml Diagrama_Componentes_Libreria
title Diagrama de Componentes - API Librería (Fredy Linares)

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #555555
}
skinparam node {
  BackgroundColor #EEF5FF
  BorderColor #2B6CB0
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #2B6CB0
}
skinparam database {
  BackgroundColor #FFF4E5
  BorderColor #C05621
}

actor "Cliente\n(Navegador / Postman)" as cliente

node "Red Docker: linares" as red {

  node "Contenedor: api-linares\n(eclipse-temurin:21-jre, puerto 8080)" as api {

    interface "/api/autores" as iAut
    interface "/api/editoriales" as iEdi
    interface "/api/libros" as iLib
    interface "/swagger-ui.html" as iSwg

    component "Swagger UI\n(springdoc-openapi)" as swagger
    component "OpenApiConfig" as openapi

    package "controller" {
      component "AutorController" as autCtrl
      component "EditorialController" as ediCtrl
      component "LibroController" as libCtrl
      component "HomeController" as homeCtrl
    }

    package "exception" {
      component "GlobalExceptionHandler" as handler
    }

    package "service" {
      component "AutorService\n(AutorServiceImpl)" as autSrv
      component "EditorialService\n(EditorialServiceImpl)" as ediSrv
      component "LibroService\n(LibroServiceImpl)" as libSrv
    }

    package "mapper" {
      component "AutorMapper" as autMap
      component "EditorialMapper" as ediMap
      component "LibroMapper" as libMap
    }

    package "persistence" {
      component "AutorRepository" as autRepo
      component "EditorialRepository" as ediRepo
      component "LibroRepository" as libRepo
      component "Entidades JPA\n(AutorEntity, EditorialEntity, LibroEntity)" as entities
    }

    component "Spring Data JPA / Hibernate\n+ Driver MariaDB" as jpa
  }

  node "Contenedor: db-linares\n(mariadb:11.4, puerto 3306)" as dbnode {
    interface "JDBC :3306" as iJdbc
    database "libreria" as db {
      [autores]
      [editoriales]
      [libros]
    }
  }
}

cliente --> iAut
cliente --> iEdi
cliente --> iLib
cliente --> iSwg

iAut -- autCtrl
iEdi -- ediCtrl
iLib -- libCtrl
iSwg -- swagger

homeCtrl ..> swagger : redirect
swagger ..> openapi : usa
swagger ..> autCtrl : documenta
swagger ..> ediCtrl : documenta
swagger ..> libCtrl : documenta

autCtrl --> autSrv
autCtrl --> libSrv
ediCtrl --> ediSrv
ediCtrl --> libSrv
libCtrl --> libSrv
handler ..> autCtrl : maneja errores
handler ..> ediCtrl : maneja errores
handler ..> libCtrl : maneja errores

autSrv --> autMap
ediSrv --> ediMap
libSrv --> libMap
autSrv --> autRepo
autSrv --> libRepo
ediSrv --> ediRepo
ediSrv --> libRepo
libSrv --> libRepo
libSrv --> autRepo
libSrv --> ediRepo

autMap ..> entities
ediMap ..> entities
libMap ..> entities
autRepo ..> entities
ediRepo ..> entities
libRepo ..> entities

autRepo --> jpa
ediRepo --> jpa
libRepo --> jpa
jpa --> iJdbc : SQL
iJdbc - db

[libros] ..> [autores] : FK id_autor
[libros] ..> [editoriales] : FK id_editorial
@enduml
